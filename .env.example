# SentinelFlow AI — Environment Configuration Template
# Copy this file to .env and configure your local or cloud endpoints

# Application Environment
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# SQLite / SQLAlchemy Database Path
DATABASE_URL=sqlite+aiosqlite:///./sentinelflow.db

# Strands Decider 2B Settings
# Start model server via: strands-decider serve StrandsAgents/strands-decider-2B-qwen3.5-v1-2610 --port 8099
STRANDS_DECIDER_URL=http://127.0.0.1:8099
STRANDS_DECIDER_MODEL=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610
# Calibrated confidence threshold (0.0 to 1.0) below which events route to human review
CONFIDENCE_THRESHOLD=0.80
DECIDER_TIMEOUT_SECONDS=30.0

# Amazon Bedrock Settings
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FALLBACK_MODEL_ID=amazon.nova-pro-v1:0

# AWS Authentication (Optional if using IAM roles or ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
